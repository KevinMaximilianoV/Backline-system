{
  "info": {
    "name": "Backline · Perfiles (Entrega 5)",
    "description": "CRUD de bandas y foros del servicio Perfiles contra la base real.\n\nEjecuta la colección completa en orden (Run collection o `npm run test:postman`): cada carpeta crea su propio recurso con un id nuevo, así que se puede correr las veces que quieras.\n\nSin autenticación hasta la Entrega 6: el id del dueño viaja en el cuerpo del POST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Toda respuesta trae X-Correlation-Id\", () => pm.response.to.have.header(\"X-Correlation-Id\"));",
          "pm.test(\"Responde en menos de 1 s\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "bandaId",
      "value": ""
    },
    {
      "key": "foroId",
      "value": ""
    }
  ],
