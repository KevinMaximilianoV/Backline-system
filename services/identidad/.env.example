# Copiar a .env (no se sube al repositorio). "npm run configurar" en la raíz lo hace por ti.
NODE_ENV=development
PORT=3001
# Usuario propio del servicio: solo puede entrar a backline_identidad
DATABASE_URL=postgresql://svc_identidad:dev_identidad@localhost:5432/backline_identidad
# Identidad es el único servicio con la llave privada: es el único que puede emitir tokens
JWT_LLAVE_PRIVADA=../../llaves/jwt-privada.pem
JWT_LLAVE_PUBLICA=../../llaves/jwt-publica.pem
# Vigencia del token de acceso, en minutos
TOKEN_MINUTOS=60
# Intentos fallidos de inicio de sesión permitidos por minuto (por IP y correo)
INTENTOS_SESION_POR_MINUTO=5
