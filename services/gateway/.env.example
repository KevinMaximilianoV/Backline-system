# Copiar a .env (no se sube al repositorio). "npm run configurar" en la raíz lo hace por ti.
NODE_ENV=development
PORT=8080
JWT_LLAVE_PUBLICA=../../llaves/jwt-publica.pem
# A dónde reenvía el Gateway cada grupo de rutas
IDENTIDAD_URL=http://localhost:3001
PERFILES_URL=http://localhost:3002
BOOKING_URL=http://localhost:3003
# Orígenes web autorizados por CORS (la app Flutter web en desarrollo), separados por comas
CORS_ORIGENES=http://localhost:5173,http://localhost:8000
