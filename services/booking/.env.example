# Copiar a .env (no se sube al repositorio). "npm run configurar" en la raíz lo hace por ti.
NODE_ENV=development
PORT=3003
# Usuario propio del servicio: solo puede entrar a backline_booking
DATABASE_URL=postgresql://svc_booking:dev_booking@localhost:5432/backline_booking
JWT_LLAVE_PUBLICA=../../llaves/jwt-publica.pem
# Booking consulta a Perfiles por HTTP (nunca su base) para nombres, rider e inventario
PERFILES_URL=http://localhost:3002
