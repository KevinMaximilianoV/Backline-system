        {
          "name": "Crear banda (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/bandas",
            "description": "TEMPORAL (Entrega 5): el id de la cuenta dueña viaja en el cuerpo. En la Entrega 6 sale del token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{bandaId}}\",\n  \"nombre\": \"Los Prueba\",\n  \"integrantes\": 4,\n  \"generoIds\": [\n    1,\n    3\n  ],\n  \"enlaceDemo\": \"https://ejemplo.com/losprueba\",\n  \"descripcion\": \"Banda creada desde Postman.\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"bandaId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve la banda creada con sus géneros\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.id).to.eql(pm.collectionVariables.get(\"bandaId\"));",
                  "  pm.expect(b.nombre).to.eql(\"Los Prueba\");",
                  "  pm.expect(b.generos.map(g => g.id)).to.eql([1, 3]);",
                  "  pm.expect(b.visible).to.be.true;",
                  "});",
                  "pm.test(\"Header Location apunta al recurso\", () =>",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/bandas/\" + pm.collectionVariables.get(\"bandaId\")));"
                ]
              }
            }
          ]
        },
