{
  "name": "@backline/identidad",
  "version": "0.2.0",
  "private": true,
  "description": "Servicio Identidad de Backline: cuentas, inicio de sesión y emisión de tokens",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backline/comun": "0.2.0",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
