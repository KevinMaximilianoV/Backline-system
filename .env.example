# Copiar a .env (ese archivo no se sube al repositorio)
POSTGRES_PASSWORD=cambia_esta_contrasena
# Cambia el puerto si ya tienes PostgreSQL instalado en tu computadora
POSTGRES_PORT=5432
ADMINER_PORT=8081
# Contraseñas de los usuarios de cada servicio en PostgreSQL. Si no se definen, se usan las de
# desarrollo (dev_identidad, ...). En un despliegue real, define valores propios aquí, y en el
# DATABASE_URL de cada servicio si los corres con npm.
# SVC_IDENTIDAD_PASSWORD=
# SVC_PERFILES_PASSWORD=
# SVC_BOOKING_PASSWORD=
# Orígenes web autorizados por CORS en el Gateway, separados por comas (perfil "completo")
CORS_ORIGENES=http://localhost:5173
GATEWAY_PORT=8080
